# =============================================================================
# Cerah AI — Konfigurasi Environment Terpusat
# Dipakai bersama oleh backend (FastAPI) dan frontend (Vite build-time).
# Salin file ini: cp .env.example .env  lalu isi nilai yang sebenarnya
# JANGAN commit file .env ke git!
# =============================================================================

# -----------------------------------------------------------------------------
# TAVILY SEARCH — Real-time job data
# Daftar gratis di: https://tavily.com  (1.000 req/bulan gratis)
# Budget per analisis: ~4 credits (jobs + salary + trends + bootcamp)
# -----------------------------------------------------------------------------
TAVILY_API_KEY=tvly-your-key-here

# -----------------------------------------------------------------------------
# GOOGLE GEMINI — Profiler + Analyst (chat completion, berjalan PARALEL)
# Daftar API key gratis di: https://aistudio.google.com/apikey
# Cek nama model persis di dashboard sebelum diisi (mis. gemini-2.5-flash / gemini-2.0-flash)
# -----------------------------------------------------------------------------
GOOGLE_API_KEY=your-google-api-key-here
GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

PROFILER_MODEL=gemini-2.5-flash
ANALYST_MODEL=gemini-2.5-flash

# -----------------------------------------------------------------------------
# GROQ — Gap Analyzer + Strategist (chat completion, sequential)
# Daftar API key gratis di: https://console.groq.com/keys
# Cek nama model persis di: https://console.groq.com/docs/models
# -----------------------------------------------------------------------------
GROQ_API_KEY=gsk_your-groq-key-here
GROQ_BASE_URL=https://api.groq.com/openai/v1

GAP_MODEL=llama-3.3-70b-versatile
STRATEGIST_MODEL=llama-3.3-70b-versatile

# -----------------------------------------------------------------------------
# Shared LLM Settings
# -----------------------------------------------------------------------------
AI_MAX_TOKENS=1200
AI_TEMPERATURE=0.35
AI_RECOMMENDATION_TEMPERATURE=0.3

# -----------------------------------------------------------------------------
# EMBEDDING — Hugging Face Inference API (FAISS semantic search)
# Daftar token gratis (tipe "Read" sudah cukup) di: https://huggingface.co/settings/tokens
# -----------------------------------------------------------------------------
HF_API_TOKEN=your-hf-token-here
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B

# -----------------------------------------------------------------------------
# SUPABASE — Riwayat analisis karier (fitur History)
# 1. Buat project baru (gratis) di https://supabase.com
# 2. Jalankan SQL skema tabel dari README.md (bagian "Setup Supabase") di SQL Editor
# 3. Ambil nilai di bawah dari Project Settings -> API
#    - SUPABASE_URL       = "Project URL"
#    - SUPABASE_SERVICE_KEY = "service_role" secret key (BUKAN anon/public key —
#      key ini hanya dipakai backend, jangan pernah dikirim ke browser)
# Jika dikosongkan, endpoint /api/history akan merespons 503 (fitur nonaktif),
# fitur analisis utama tetap berjalan normal tanpa Supabase.
# -----------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here

# -----------------------------------------------------------------------------
# FRONTEND — dibaca Vite saat BUILD TIME (bukan runtime)
# Untuk dev manual (npm run dev) tanpa Docker, Vite butuh file .env sendiri di
# frontend/app/ (batasan teknis Vite, tidak bisa baca folder lain) — salin baris
# ini ke frontend/app/.env secara manual. Untuk Docker, docker-compose.yml sudah
# meneruskan variabel ini otomatis saat build image frontend.
# -----------------------------------------------------------------------------
VITE_BACKEND_URL=http://localhost:8000
